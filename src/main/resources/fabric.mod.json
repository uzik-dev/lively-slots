{
  "schemaVersion": 1,
  "id": "lively_slots",
  "version": "${version}",
  "name": "Lively Slots",
  "description": "Inventory items pop into slots, pulse when a stack grows and fly across on shift-click. Client-side only.",
  "authors": [
    "UZIK"
  ],
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/uzik-dev/lively-slots",
    "issues": "https://github.com/uzik-dev/lively-slots/issues"
  },
  "icon": "assets/lively_slots/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.vlads.livelyslots.LivelySlots"
    ]
  },
  "mixins": [
    "lively_slots.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=26.1 <26.4",
    "java": ">=25"
  }
}
